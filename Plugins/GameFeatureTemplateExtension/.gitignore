# Visual Studio 2015 user specific files
.vs/
*.vsconfig
*.DotSettings.user

# Idea Jetbrains user specific files
.idea/
*.ddargs.json

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
*.pdb
*.exp
*.lib
*.target
*.modules

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Enable binaries subfolder
!Binaries/*/
!Plugins/**/Binaries/*/

# Only necessaries DLL for opening the editor
!Binaries/*/UnrealEditor-*.dll
!Binaries/*/*.modules
!Binaries/*/*Editor.target

!Plugins/**/Binaries/*/UnrealEditor-*.dll
!Plugins/**/Binaries/*/*.modules
!Plugins/**/Binaries/*/*Editor.target

# Git LFS files
!git-lfs.exe
!git-lfs
!git-lfs-mac-amd64
!git-lfs-mac-arm64

# Builds
[Bb]uilds/

# Build
Build/*
!Build/*/

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*
.DS_Store

# Wwise cache / temp
.WwiseCache/
.cache/
*.log

# Local user settings
*.user
*.session

# Generated intermediates
GeneratedSoundBanks/**/Metadata
